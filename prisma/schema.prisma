datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                      String       @id                    // Supabase Auth UUID
  display_name            String?
  email                   String?      @unique
  avatar_url              String?
  auth_provider           String?                             // "google", "apple", etc.
  tier                    String       @default("free")
  tokens                  Int          @default(10)
  stripe_customer_id      String?      @unique
  stripe_subscription_id  String?
  created_at              DateTime     @default(now())
  generations             Generation[]

  @@map("users")
}

model StripeEvent {
  event_id   String   @id
  created_at DateTime @default(now())

  @@map("stripe_events")
}

model Generation {
  id                    String   @id
  user_id               String?
  image_path            String
  dominant_colors       String   // Store JSON array as string
  environmental_context String?
  emotional_vibe        String?
  seed_genres           String   // Store JSON array as string
  valence               Float
  energy                Float
  acousticness          Float
  playlist_id           String?
  playlist_name         String?
  playlist_url          String?
  tracks                Json?
  suggested_tracks      Json?
  created_at            DateTime @default(now())
  user                  User?    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("generations")
}
