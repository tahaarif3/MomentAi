# Server Configuration
PORT=3000
SESSION_SECRET=super_secret_session_key_change_me
COOKIE_SECRET=another_cryptographic_secret_for_cookie_signing

# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# Spotify OAuth Configuration
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/auth/callback

# Database Configuration (PostgreSQL/Prisma)
# Example: postgresql://janedoe:mypassword@localhost:5432/mydb?schema=public&connection_limit=5
DATABASE_URL="postgresql://user:password@hostname:5432/dbname?schema=public&connection_limit=5"

# File Storage Configuration (local or s3)
STORAGE_PROVIDER=local

# AWS S3 / Cloudflare R2 Settings (Required if STORAGE_PROVIDER=s3)
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=your_s3_bucket_name

# Optional S3 Customizations (e.g., for Cloudflare R2 / Custom CDN)
# AWS_S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# AWS_S3_FORCE_PATH_STYLE=false
# AWS_S3_SKIP_ACL=true
# AWS_S3_CUSTOM_DOMAIN=https://your-custom-cdn-or-r2-domain.com
