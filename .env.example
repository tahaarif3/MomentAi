# Server Configuration
PORT=3000
NODE_ENV=development
SESSION_SECRET=super_secret_session_key_change_me
COOKIE_SECRET=another_cryptographic_secret_for_cookie_signing

# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# Spotify OAuth Configuration
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/auth/callback

# Database Configuration (Supabase PostgreSQL / Prisma)
# Project: MomentAi (bonebcazubomgwuirwfr) — copy from Dashboard → Connect → Prisma
# URL-encode special chars in password: ! → %21  + → %2B  @ → %40  # → %23
#
# Local dev — session pooler (IPv4, port 5432)
DATABASE_URL="postgresql://postgres.bonebcazubomgwuirwfr:[URL-ENCODED-PASSWORD]@aws-1-us-east-2.pooler.supabase.com:5432/postgres"
DIRECT_URL="postgresql://postgres.bonebcazubomgwuirwfr:[URL-ENCODED-PASSWORD]@aws-1-us-east-2.pooler.supabase.com:5432/postgres"
#
# DigitalOcean production — transaction pooler for runtime, session pooler for migrations
# Set NODE_ENV=production and APP_BASE_URL to your *.ondigitalocean.app or custom domain.
# Health check path on DO: /health/live (liveness). Use /health to verify database connectivity.
# DATABASE_URL="postgresql://postgres.bonebcazubomgwuirwfr:[URL-ENCODED-PASSWORD]@aws-1-us-east-2.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL="postgresql://postgres.bonebcazubomgwuirwfr:[URL-ENCODED-PASSWORD]@aws-1-us-east-2.pooler.supabase.com:5432/postgres"

# File Storage Configuration (local or s3)
# Production / mobile: use s3 with DigitalOcean Spaces so uploads survive redeploys.
STORAGE_PROVIDER=local

# AWS S3 / DigitalOcean Spaces / Cloudflare R2 (Required if STORAGE_PROVIDER=s3)
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=nyc3
AWS_S3_BUCKET_NAME=your_spaces_bucket_name

# DigitalOcean Spaces example:
# AWS_S3_ENDPOINT=https://nyc3.digitaloceanspaces.com
# AWS_S3_CUSTOM_DOMAIN=https://your-bucket.nyc3.cdn.digitaloceanspaces.com
# AWS_S3_FORCE_PATH_STYLE=false
# AWS_S3_SKIP_ACL=false
# See docs/spaces-setup.md for CORS (required for share-card canvas).

# Job progress token HMAC secret (falls back to SESSION_SECRET)
# JOB_PROGRESS_SECRET=long_random_string

# Native app force-upgrade / compatibility (GET /api/mobile/compatibility)
# MOBILE_MIN_IOS_VERSION=1.0.0
# MOBILE_MIN_ANDROID_VERSION=1.0.0
# MOBILE_MIN_APP_VERSION=1.0.0
# MOBILE_FORCE_UPGRADE=false
# MOBILE_FORCE_UPGRADE_MESSAGE=Please update MomentAI to continue.
# MOBILE_STORE_BILLING_ENABLED=false

# RevenueCat store webhook → sync users.tier (native Premium)
# REVENUECAT_WEBHOOK_SECRET=your_revenuecat_webhook_auth_secret

# Stripe Payments (https://dashboard.stripe.com/apikeys)
# Use test keys locally; live keys in production. Prefer restricted keys (rk_) over secret keys (sk_).
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret
# Public site URL (Checkout redirects, CORS). Production: https://momentai.dev
APP_BASE_URL=http://127.0.0.1:3000
# Optional: override auto-resolved price IDs (lookup keys are resolved automatically if omitted)
# STRIPE_TOKEN_PACK_PRICE_ID=price_xxx
# STRIPE_PREMIUM_PRICE_ID=price_xxx
# STRIPE_TOKEN_PACK_LOOKUP_KEY=momentai_token_pack_20
# STRIPE_PREMIUM_LOOKUP_KEY=momentai_premium_monthly

# Supabase Auth Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Spotify Master Account (run 'node scripts/spotify-master-setup.js' to obtain)
SPOTIFY_MASTER_REFRESH_TOKEN=

# Redis Configuration (Required for BullMQ async queue)
REDIS_URL=redis://127.0.0.1:6379
