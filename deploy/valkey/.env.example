# The private IPv4 address shown for the Valkey Droplet in DigitalOcean's VPC.
# Never use its public IPv4 address here.
VALKEY_PRIVATE_IP=10.0.0.10

# Generate with: openssl rand -hex 32
# Hex output is safe to use directly in App Platform's REDIS_URL.
VALKEY_PASSWORD=replace-with-a-long-random-secret
